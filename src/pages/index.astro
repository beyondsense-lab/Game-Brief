---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import NewsletterSignup from '@/components/NewsletterSignup.astro'; import { getPublishedArticles, getTrendingArticles, getGames } from '@/db/queries/public';
const latest=await getPublishedArticles(Astro,9); const trending=await getTrendingArticles(Astro); const games=await getGames(Astro,4); const hero=latest[0];
---
<BaseLayout seo={{title:'GAME//BRIEF — The gaming news worth knowing.',description:'Gaming news, reviews, guides, releases and a focused daily newsletter.'}}><section class="container py-10"><div class="grid gap-6 lg:grid-cols-[1.5fr_.8fr]"><article class="border border-line bg-paper text-zinc-900 shadow-brutal"><a href={hero?`/news/${hero.slug}`:'/news'}>{hero?.hero_image&&<img src={hero.hero_image} alt={hero.hero_image_alt||''} width="1200" height="675" class="aspect-video w-full object-cover"/>}<div class="p-6"><p class="text-xs font-black uppercase tracking-[.22em]">Lead Brief</p><h1 class="mt-3 text-4xl font-black leading-none md:text-6xl">{hero?.title||'Gaming news worth knowing, built from your CMS.'}</h1><p class="mt-4 max-w-2xl text-lg font-semibold text-zinc-700">{hero?.excerpt||'Publish articles in the CMS and they appear here automatically.'}</p></div></a></article><aside class="card p-5"><h2 class="kicker">Trending</h2><div class="mt-4 divide-y divide-line">{trending.map((s:any,i:number)=><a class="block py-4" href={`/news/${s.slug}`}><span class="text-acid font-black">0{i+1}</span><h3 class="font-black">{s.title}</h3></a>)}</div></aside></div></section><section class="container py-8"><h2 class="kicker">Latest News</h2><div class="mt-4 grid gap-5 md:grid-cols-3">{latest.slice(1).map((s:any)=><StoryCard story={s}/>)}</div></section><section class="container py-8"><h2 class="kicker">Upcoming Releases</h2><div class="mt-4 grid gap-4 md:grid-cols-4">{games.map((g:any)=><a class="card p-4" href={`/games/${g.slug}`}><h3 class="font-black">{g.name}</h3><p class="text-sm text-muted">{g.genre} · {g.release_date||'TBA'}</p></a>)}</div></section><NewsletterSignup /></BaseLayout>
