---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { first, getArticlesByCategory } from '@/db/queries/public'; const category=await first(Astro,`SELECT * FROM categories WHERE slug='esports'`); const articles=category?await getArticlesByCategory(Astro,category.id,24):[];
---
<BaseLayout seo={{title:category?.seo_title||'Esports — GAME//BRIEF',description:category?.seo_description||'Competitive gaming, tournaments and esports industry news.',path:'/esports'}}><section class="container py-10"><p class="kicker">GAME//BRIEF</p><h1 class="text-5xl font-black">Esports</h1><p class="mt-4 max-w-2xl text-muted">{category?.description||'Competitive gaming, tournaments and esports industry news.'}</p><div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((s:any)=><StoryCard story={s}/>)}</div>{articles.length===0&&<p class="mt-5 text-muted">No published esports stories yet — check back soon.</p>}</section></BaseLayout>
