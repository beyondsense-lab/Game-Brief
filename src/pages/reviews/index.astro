---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getReviews } from '@/db/queries/public'; const reviews=await getReviews(Astro,24);
---
<BaseLayout seo={{title:'Reviews — GAME//BRIEF',description:'GAME//BRIEF game reviews, scores and verdicts.',path:'/reviews'}}><section class="container py-10"><p class="kicker">GAME//BRIEF</p><h1 class="text-5xl font-black">Reviews</h1><p class="mt-4 text-muted">Honest scores and verdicts on the games that matter.</p><div class="mt-8 grid gap-5 md:grid-cols-3">{reviews.map((r:any)=><a class="card group overflow-hidden" href={`/news/${r.article_slug}`}>{r.article_hero_image&&<img src={r.article_hero_image} alt={r.article_hero_image_alt||''} width="800" height="450" class="aspect-video w-full object-cover" loading="lazy"/>}<div class="p-5"><div class="flex items-center justify-between"><p class="kicker">{r.game_name||'Review'}</p><span class="text-2xl font-black text-acid">{r.score}</span></div><h3 class="mt-2 text-xl font-black leading-tight group-hover:text-acid">{r.article_title}</h3><p class="mt-2 text-sm text-muted">{r.verdict}</p></div></a>)}</div>{reviews.length===0&&<p class="mt-5 text-muted">No published reviews yet.</p>}</section></BaseLayout>
