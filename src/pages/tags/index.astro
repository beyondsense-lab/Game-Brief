---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getTags } from '@/db/queries/public'; const tags=await getTags(Astro);
---
<BaseLayout seo={{title:'Tags — GAME//BRIEF',description:'Browse GAME//BRIEF coverage by tag.',path:'/tags'}}><section class="container py-10"><p class="kicker">Database</p><h1 class="text-5xl font-black">Tags</h1><p class="mt-4 text-muted">Explore news, reviews and guides organized by tag.</p><div class="mt-8 flex flex-wrap gap-3">{tags.map((t:any)=><a class="card px-4 py-2 font-bold hover:text-acid" href={`/tags/${t.slug}`}>{t.name}</a>)}</div>{tags.length===0&&<p class="mt-5 text-muted">No tags published yet.</p>}</section></BaseLayout>
