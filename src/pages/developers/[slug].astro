---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getDeveloperBySlug, getGamesByDeveloper } from '@/db/queries/public'; const developer=await getDeveloperBySlug(Astro,Astro.params.slug!); if(!developer) return Astro.redirect('/404'); const games=await getGamesByDeveloper(Astro,developer.id,24);
---
<BaseLayout seo={{title:developer.seo_title||`${developer.name} — GAME//BRIEF`,description:developer.seo_description||developer.description||`${developer.name} on GAME//BRIEF.`,path:`/developers/${developer.slug}`}}><section class="container py-10"><p class="kicker">Developer</p><div class="mt-2 flex items-center gap-4">{developer.logo?<img src={developer.logo} alt={developer.name} width="88" height="88" class="rounded-full object-cover"/>:<span class="flex h-[88px] w-[88px] items-center justify-center rounded-full border border-line bg-panel text-4xl font-black text-acid">{developer.name?.[0]?.toUpperCase()||'?'}</span>}<h1 class="text-5xl font-black">{developer.name}</h1></div>{developer.description&&<p class="mt-4 max-w-2xl text-muted">{developer.description}</p>}{developer.website&&<a class="mt-2 inline-block text-sm font-bold text-acid" href={developer.website} rel="noopener noreferrer" target="_blank">Website</a>}{games.length>0&&<div class="mt-8"><h2 class="kicker">Games</h2><div class="mt-4 grid gap-4 md:grid-cols-4">{games.map((g:any)=><a class="card overflow-hidden" href={`/games/${g.slug}`}>{g.cover_image&&<img src={g.cover_image} alt={g.cover_image_alt||''} class="aspect-[3/4] w-full object-cover"/>}<div class="p-4"><h3 class="font-black">{g.name}</h3></div></a>)}</div></div>}</section></BaseLayout>
