---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getDevelopers } from '@/db/queries/public'; const developers=await getDevelopers(Astro);
---
<BaseLayout seo={{title:'Developers — GAME//BRIEF',description:'Meet the people behind GAME//BRIEF.',path:'/developers'}}><section class="container py-10"><p class="kicker">Team</p><h1 class="text-5xl font-black">Developers</h1><p class="mt-4 text-muted">The people who build and run GAME//BRIEF.</p><div class="mt-8 grid gap-4 md:grid-cols-3">{developers.map((d:any)=><a class="card flex items-center gap-3 p-5" href={`/developers/${d.slug}`}>{d.logo?<img src={d.logo} alt={d.name} width="48" height="48" class="rounded-full object-cover"/>:<span class="flex h-12 w-12 items-center justify-center rounded-full border border-line bg-panel text-lg font-black text-acid">{d.name?.[0]?.toUpperCase()||'?'}</span>}<span class="font-black">{d.name}</span></a>)}</div>{developers.length===0&&<p class="mt-5 text-muted">No developers published yet.</p>}</section></BaseLayout>
