---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { getGameBySlug,getPublishedArticles } from '@/db/queries/public'; const game=await getGameBySlug(Astro,Astro.params.slug!); if(!game) return Astro.redirect('/404'); const news=(await getPublishedArticles(Astro,12)).filter((a:any)=>a.game_id===game.id);
---
<BaseLayout seo={{title:game.seo_title||`${game.name} news, reviews and guides`,description:game.seo_description||game.description,path:`/games/${game.slug}`,image:game.cover_image}}><section class="container grid gap-8 py-10 md:grid-cols-[320px_1fr]"><div>{game.cover_image&&<img src={game.cover_image} alt={game.cover_image_alt||''} width="640" height="860" class="border border-line"/>}</div><div><p class="kicker">Game Hub</p><h1 class="mt-2 text-6xl font-black">{game.name}</h1><p class="mt-4 text-xl text-muted">{game.description}</p><dl class="mt-6 grid gap-3 sm:grid-cols-2"><div class="card p-4"><dt class="kicker">Release</dt><dd>{game.release_date||'TBA'}</dd></div><div class="card p-4"><dt class="kicker">Genre</dt><dd>{game.genre}</dd></div><div class="card p-4"><dt class="kicker">Developer</dt><dd><a href={`/developers/${game.developer_slug}`}>{game.developer_name}</a></dd></div><div class="card p-4"><dt class="kicker">Publisher</dt><dd><a href={`/publishers/${game.publisher_slug}`}>{game.publisher_name}</a></dd></div></dl></div></section><section class="container py-8"><h2 class="kicker">Latest coverage</h2><div class="mt-4 grid gap-5 md:grid-cols-3">{news.map((s:any)=><StoryCard story={s}/>)}</div></section></BaseLayout>
