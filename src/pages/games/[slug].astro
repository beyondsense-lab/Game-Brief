---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { getGameBySlug,getArticlesByGame,getPlatformsForGame } from '@/db/queries/public'; const game=await getGameBySlug(Astro,Astro.params.slug!); if(!game) return Astro.redirect('/404'); const news=await getArticlesByGame(Astro,game.id,24); const platforms=await getPlatformsForGame(Astro,game.id);
---
<BaseLayout seo={{title:game.seo_title||`${game.name} news, reviews and guides`,description:game.seo_description||game.description,path:`/games/${game.slug}`,image:game.cover_image}}><section class="container grid gap-8 py-10 md:grid-cols-[320px_1fr]"><div>{game.cover_image&&<img src={game.cover_image} alt={game.cover_image_alt||''} width="640" height="860" class="border border-line"/>}</div><div><p class="kicker">Game Hub</p><h1 class="mt-2 text-6xl font-black">{game.name}</h1><p class="mt-4 text-xl text-muted">{game.description}</p><dl class="mt-6 grid gap-3 sm:grid-cols-2"><div class="card p-4"><dt class="kicker">Release</dt><dd>{game.release_date||'TBA'}</dd></div><div class="card p-4"><dt class="kicker">Genre</dt><dd>{game.genre||'—'}</dd></div><div class="card p-4"><dt class="kicker">Developer</dt><dd>{game.developer_slug?<a href={`/developers/${game.developer_slug}`}>{game.developer_name}</a>:(game.developer_name||'—')}</dd></div></dl>{platforms.length>0&&<div class="mt-6"><p class="kicker">Available on</p><div class="mt-2 flex flex-wrap gap-2">{platforms.map((p:any)=><a class="card px-3 py-1 text-sm font-bold hover:text-acid" href={`/platforms/${p.slug}`}>{p.name}</a>)}</div></div>}{game.official_website&&<a class="btn mt-6 inline-block" href={game.official_website} rel="noopener noreferrer" target="_blank">Official website</a>}</div></section><section class="container py-8"><h2 class="kicker">Latest coverage</h2><div class="mt-4 grid gap-5 md:grid-cols-3">{news.map((s:any)=><StoryCard story={s}/>)}</div>{news.length===0&&<p class="mt-5 text-muted">No published stories about {game.name} yet.</p>}</section></BaseLayout>
