---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { getCategoryBySlug, getArticlesByCategory } from '@/db/queries/public'; const category=await getCategoryBySlug(Astro,Astro.params.slug!); if(!category) return Astro.redirect('/404'); const articles=await getArticlesByCategory(Astro,category.id,24);
---
<BaseLayout seo={{title:category.seo_title||`${category.name} — GAME//BRIEF`,description:category.seo_description||category.description||`GAME//BRIEF coverage in ${category.name}.`,path:`/categories/${category.slug}`}}><section class="container py-10"><p class="kicker">Category</p><h1 class="text-5xl font-black">{category.name}</h1>{category.description&&<p class="mt-4 max-w-2xl text-muted">{category.description}</p>}<div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((s:any)=><StoryCard story={s}/>)}</div>{articles.length===0&&<p class="mt-5 text-muted">No published stories in {category.name} yet.</p>}</section></BaseLayout>
