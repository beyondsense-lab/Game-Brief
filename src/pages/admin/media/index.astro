---
import { env } from 'cloudflare:workers';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { all } from '@/db/queries/public';
import { getStorage } from '@/lib/storage';
const media=await all(Astro,'SELECT * FROM media ORDER BY created_at DESC LIMIT 100');
const storage=await getStorage(env).status();
---
<AdminLayout><div class="flex items-start justify-between"><div><h1 class="text-3xl font-black">Media</h1><p class="mt-2 text-sm text-muted">Media Storage: {storage.provider} · {storage.configured?'Connected':'Not configured'}</p></div></div><form class="card mt-5 grid gap-3 p-5" method="post" action="/api/admin/media" enctype="multipart/form-data"><label class="kicker">Upload Image<input class="input mt-2" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif" required/></label><select class="input" name="folder"><option value="general">General</option><option value="articles">Articles</option><option value="games">Games</option><option value="reviews">Reviews</option><option value="guides">Guides</option><option value="authors">Authors</option><option value="developers">Developers</option><option value="publishers">Publishers</option><option value="newsletter">Newsletter</option></select><input class="input" name="slug" placeholder="Optional slug/public ID hint"/><input class="input" name="altText" placeholder="Alt text"/><textarea class="input" name="caption" placeholder="Caption"></textarea><button class="btn">Upload Image</button></form><div class="mt-6 grid gap-4 md:grid-cols-3">{media.map((m:any)=><article class="card overflow-hidden"><img src={m.secure_url||m.url} alt={m.alt_text||''} class="aspect-video w-full object-cover" loading="lazy" decoding="async"/><div class="p-4 text-sm"><p class="font-black">{m.filename}</p><p class="text-muted">{m.provider} · {m.width||'?'}×{m.height||'?'} · {m.bytes||0} bytes</p><p class="text-muted">{m.alt_text}</p><button class="mt-2 text-acid" data-url={m.secure_url||m.url}>Copy URL</button></div></article>)}</div></AdminLayout>
