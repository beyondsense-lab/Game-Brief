---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { env } from 'cloudflare:workers'; const me=Astro.locals.user; const saved=Astro.url.searchParams.get('saved')==='1';
---
<AdminLayout><h1 class="text-3xl font-black">Settings</h1><p class="mt-4 text-muted">Manage your admin account and see the current site configuration.</p>{saved&&<div class="mt-5 border-2 border-acid bg-acid/10 p-4 font-bold text-acid" role="status">Account updated.</div>}<div class="mt-5 grid gap-5 lg:grid-cols-2"><form method="post" action="/api/admin/account" class="card p-5"><h2 class="kicker">Your account</h2><label class="mt-3 block text-sm font-bold">Name<input class="input mt-2" name="name" value={me?.name||''} required/></label><label class="mt-3 block text-sm font-bold">Email<input class="input mt-2" name="email" type="email" value={me?.email||''} required/></label><label class="mt-3 block text-sm font-bold">New password<input class="input mt-2" name="newPassword" type="password" placeholder="Leave blank to keep current password"/></label><p class="mt-2 text-xs text-muted">Role: {me?.role}</p><button class="btn mt-4">Save account</button></form><div class="card p-5"><h2 class="kicker">Site configuration</h2><p class="mt-2 text-xs text-muted">These values are set as Cloudflare Worker environment variables and secrets — edit them in wrangler.toml or the Cloudflare dashboard, not here.</p><dl class="mt-4 grid gap-3 text-sm"><div class="flex justify-between border-b border-line pb-2"><dt class="text-muted">Site URL</dt><dd class="font-bold">{env.PUBLIC_SITE_URL||'—'}</dd></div><div class="flex justify-between border-b border-line pb-2"><dt class="text-muted">Email provider</dt><dd class="font-bold">{env.EMAIL_PROVIDER||'—'}</dd></div><div class="flex justify-between border-b border-line pb-2"><dt class="text-muted">Email from</dt><dd class="font-bold">{env.EMAIL_FROM||'—'}</dd></div><div class="flex justify-between border-b border-line pb-2"><dt class="text-muted">Cloudinary</dt><dd class="font-bold">{env.CLOUDINARY_CLOUD_NAME?'Configured':'Not configured'}</dd></div><div class="flex justify-between"><dt class="text-muted">Database</dt><dd class="font-bold text-acid">Connected</dd></div></dl></div></div></AdminLayout>
