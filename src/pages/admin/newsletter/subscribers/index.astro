---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const subs=await all(Astro,'SELECT email,name,status,source,subscribed_at,unsubscribed_at,created_at FROM newsletter_subscribers ORDER BY created_at DESC LIMIT 500'); const activeCount=subs.filter((s:any)=>s.status==='active').length; const inactiveCount=subs.length-activeCount;
---
<AdminLayout><div class="flex items-center justify-between"><h1 class="text-3xl font-black">Newsletter Subscribers</h1><a class="text-sm font-bold text-acid" href="/admin/newsletter">Back to Newsletter</a></div><div class="mt-5 flex gap-4"><div class="card p-4"><p class="kicker">Active</p><p class="mt-1 text-3xl font-black text-acid">{activeCount}</p></div><div class="card p-4"><p class="kicker">Inactive</p><p class="mt-1 text-3xl font-black text-muted">{inactiveCount}</p></div><div class="card p-4"><p class="kicker">Total</p><p class="mt-1 text-3xl font-black">{subs.length}</p></div></div><table class="mt-6 w-full text-sm"><thead><tr class="text-left text-muted"><th>Email</th><th>Name</th><th>Status</th><th>Source</th><th>Subscribed</th></tr></thead><tbody>{subs.map((s:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{s.email}</td><td class="text-muted">{s.name||'—'}</td><td>{s.status==='active'?<span class="border border-acid px-2 py-0.5 text-xs font-black uppercase text-acid">Active</span>:<span class="border border-line px-2 py-0.5 text-xs font-black uppercase text-muted">Inactive</span>}</td><td class="text-muted">{s.source||'—'}</td><td class="text-muted">{s.subscribed_at||s.created_at}</td></tr>)}</tbody></table>{subs.length===0&&<p class="mt-5 text-muted">No subscribers yet.</p>}</AdminLayout>
