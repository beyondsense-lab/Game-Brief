---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const subs=await all(Astro,'SELECT email,name,status,source,created_at FROM newsletter_subscribers ORDER BY created_at DESC LIMIT 100');
---
<AdminLayout><h1 class="text-3xl font-black">Newsletter Subscribers</h1><table class="mt-5 w-full"><tbody>{subs.map((s:any)=><tr class="border-t border-line"><td class="py-3">{s.email}</td><td>{s.name}</td><td>{s.status}</td><td>{s.source}</td><td>{s.created_at}</td></tr>)}</tbody></table></AdminLayout>
