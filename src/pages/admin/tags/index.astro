---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT * FROM tags ORDER BY name ASC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Tags</h1><a class="btn" href="/admin/tags/new">New tag</a></div><p class="mt-4 text-muted">Manage tag slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>SEO title</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((t:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{t.name}</td><td class="text-muted">{t.slug}</td><td class="text-muted">{t.seo_title||'—'}</td><td class="text-muted">{t.updated_at}</td><td><a class="text-acid" href={`/admin/tags/${t.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No tags yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
