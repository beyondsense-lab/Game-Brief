---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; import { ensureEsportsCategory } from '@/db/queries/admin'; const category=await ensureEsportsCategory(); const status=Astro.url.searchParams.get('status')||''; const q=Astro.url.searchParams.get('q')||''; const rows=await all(Astro,`SELECT a.*,au.name author_name FROM articles a LEFT JOIN authors au ON au.id=a.author_id WHERE a.category_id=? AND (?='' OR a.status=?) AND (?='' OR a.title LIKE ?) ORDER BY updated_at DESC`,category.id,status,status,q,`%${q}%`);
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Esports</h1><a class="btn" href={`/admin/articles/new?category=esports`}>New esports article</a></div><p class="mt-4 text-muted">Esports news is managed as regular articles filed under the "Esports" category, so it flows through the same editorial workflow, publishing pipeline and SEO tooling as every other story.</p><form class="mt-5 flex gap-2"><input class="input max-w-xs" name="q" value={q} placeholder="Search"/><select class="input max-w-xs" name="status"><option value="">All</option><option selected={status==='draft'}>draft</option><option selected={status==='scheduled'}>scheduled</option><option selected={status==='published'}>published</option><option selected={status==='archived'}>archived</option></select><button class="btn">Filter</button></form><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Title</th><th>Status</th><th>Author</th><th>Published</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((a:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{a.title}</td><td>{a.status}</td><td>{a.author_name}</td><td>{a.published_at}</td><td>{a.updated_at}</td><td><a class="text-acid" href={`/admin/articles/${a.id}/edit`}>Edit</a> · <a href={`/admin/articles/${a.id}/preview`}>Preview</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No esports articles yet. Create your first one to populate the public /esports page.</p>}</AdminLayout>
