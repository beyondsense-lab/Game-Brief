---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT r.*,a.title article_title,g.name game_name FROM reviews r LEFT JOIN articles a ON a.id=r.article_id LEFT JOIN games g ON g.id=r.game_id ORDER BY r.updated_at DESC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Reviews</h1><a class="btn" href="/admin/reviews/new">New review</a></div><p class="mt-4 text-muted">Review scores and verdicts, linked to their write-up article and game.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Article</th><th>Game</th><th>Score</th><th>Platform</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((r:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{r.article_title||`Article #${r.article_id}`}</td><td class="text-muted">{r.game_name||'—'}</td><td class="font-black text-acid">{r.score??'—'}</td><td class="text-muted">{r.platform||'—'}</td><td class="text-muted">{r.updated_at}</td><td><a class="text-acid" href={`/admin/reviews/${r.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No reviews yet. Write the article first, then attach a review score here.</p>}</AdminLayout>
