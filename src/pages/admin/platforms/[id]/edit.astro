---
import AdminLayout from '@/layouts/AdminLayout.astro'; import AdminTaxonomyForm from '@/components/AdminTaxonomyForm.astro'; import { first } from '@/db/queries/public'; const item=await first(Astro,'SELECT * FROM platforms WHERE id=?',Astro.params.id);
---
<AdminLayout><h1 class="mb-5 text-3xl font-black">Edit Platform</h1><AdminTaxonomyForm kind="platform" item={item} action={`/api/admin/platforms?id=${Astro.params.id}`} /></AdminLayout>
