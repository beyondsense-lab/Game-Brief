---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT * FROM platforms ORDER BY name ASC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Platforms</h1><a class="btn" href="/admin/platforms/new">New platform</a></div><p class="mt-4 text-muted">Manage platform slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>SEO title</th><th>Actions</th></tr></thead><tbody>{rows.map((p:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{p.name}</td><td class="text-muted">{p.slug}</td><td class="text-muted">{p.seo_title||'—'}</td><td><a class="text-acid" href={`/admin/platforms/${p.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No platforms yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
