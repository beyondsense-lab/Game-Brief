---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const status=Astro.url.searchParams.get('status')||''; const q=Astro.url.searchParams.get('q')||''; const rows=await all(Astro,`SELECT a.*,au.name author_name,c.name category_name FROM articles a LEFT JOIN authors au ON au.id=a.author_id LEFT JOIN categories c ON c.id=a.category_id WHERE (?='' OR a.status=?) AND (?='' OR a.title LIKE ?) ORDER BY updated_at DESC`,status,status,q,`%${q}%`);
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Articles</h1><a class="btn" href="/admin/articles/new">New article</a></div><form class="mt-5 flex gap-2"><input class="input max-w-xs" name="q" value={q} placeholder="Search"/><select class="input max-w-xs" name="status"><option value="">All</option><option>draft</option><option>scheduled</option><option>published</option><option>archived</option></select><button class="btn">Filter</button></form><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Title</th><th>Status</th><th>Author</th><th>Category</th><th>Published</th><th>Updated</th><th>Flags</th><th>Actions</th></tr></thead><tbody>{rows.map((a:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{a.title}</td><td>{a.status}</td><td>{a.author_name}</td><td>{a.category_name}</td><td>{a.published_at}</td><td>{a.updated_at}</td><td>{a.featured?'Featured ':''}{a.trending?'Trending':''}</td><td><a class="text-acid" href={`/admin/articles/${a.id}/edit`}>Edit</a> · <a href={`/admin/articles/${a.id}/preview`}>Preview</a></td></tr>)}</tbody></table></AdminLayout>
