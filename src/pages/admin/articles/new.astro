---
import AdminLayout from '@/layouts/AdminLayout.astro'; import AdminArticleForm from '@/components/AdminArticleForm.astro'; import { first, all } from '@/db/queries/public'; const categorySlug=Astro.url.searchParams.get('category'); const presetCategory=categorySlug?await first(Astro,'SELECT id FROM categories WHERE slug=?',categorySlug):null; const article=presetCategory?{category_id:presetCategory.id}:{}; const authors=await all(Astro,'SELECT id,name FROM authors ORDER BY name ASC'); const categories=await all(Astro,'SELECT id,name FROM categories ORDER BY name ASC'); const games=await all(Astro,'SELECT id,name FROM games ORDER BY name ASC');
---
<AdminLayout><h1 class="mb-5 text-3xl font-black">New Article</h1>{(authors.length===0||categories.length===0)&&<div class="card mb-5 border-2 border-red-400 p-4 text-sm font-bold text-red-400">{authors.length===0&&<p>No authors exist yet — <a class="underline" href="/admin/authors/new">create one first</a>.</p>}{categories.length===0&&<p>No categories exist yet — <a class="underline" href="/admin/categories/new">create one first</a>.</p>}</div>}<AdminArticleForm article={article} authors={authors} categories={categories} games={games} /></AdminLayout>
