---
import AdminLayout from '@/layouts/AdminLayout.astro'; import AdminTaxonomyForm from '@/components/AdminTaxonomyForm.astro'; import { first } from '@/db/queries/public'; const item=await first(Astro,'SELECT * FROM categories WHERE id=?',Astro.params.id);
---
<AdminLayout><h1 class="mb-5 text-3xl font-black">Edit Category</h1><AdminTaxonomyForm kind="category" item={item} action={`/api/admin/categories?id=${Astro.params.id}`} /></AdminLayout>
