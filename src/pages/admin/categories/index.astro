---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT c.*,p.name parent_name FROM categories c LEFT JOIN categories p ON p.id=c.parent_id ORDER BY c.name ASC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Categories</h1><a class="btn" href="/admin/categories/new">New category</a></div><p class="mt-4 text-muted">Manage category slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>Parent</th><th>SEO title</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((c:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{c.name}</td><td class="text-muted">{c.slug}</td><td class="text-muted">{c.parent_name||'—'}</td><td class="text-muted">{c.seo_title||'—'}</td><td class="text-muted">{c.updated_at}</td><td><a class="text-acid" href={`/admin/categories/${c.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No categories yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
