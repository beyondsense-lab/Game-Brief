---
import AdminLayout from '@/layouts/AdminLayout.astro'; import AdminTaxonomyForm from '@/components/AdminTaxonomyForm.astro'; import { first } from '@/db/queries/public'; const item=await first(Astro,'SELECT * FROM developers WHERE id=?',Astro.params.id);
---
<AdminLayout><h1 class="mb-5 text-3xl font-black">Edit Developer</h1><AdminTaxonomyForm kind="developer" item={item} action={`/api/admin/developers?id=${Astro.params.id}`} /></AdminLayout>
