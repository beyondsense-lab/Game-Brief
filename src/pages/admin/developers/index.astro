---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT * FROM developers ORDER BY name ASC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Developers</h1><a class="btn" href="/admin/developers/new">New developer</a></div><p class="mt-4 text-muted">Manage developer slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>SEO title</th><th>Actions</th></tr></thead><tbody>{rows.map((d:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{d.name}</td><td class="text-muted">{d.slug}</td><td class="text-muted">{d.seo_title||'—'}</td><td><a class="text-acid" href={`/admin/developers/${d.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No developers yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
