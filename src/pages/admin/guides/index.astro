---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT gu.*,ga.name game_name,au.name author_name FROM guides gu LEFT JOIN games ga ON ga.id=gu.game_id LEFT JOIN authors au ON au.id=gu.author_id ORDER BY gu.updated_at DESC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Guides</h1><a class="btn" href="/admin/guides/new">New guide</a></div><p class="mt-4 text-muted">Manage guide slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Title</th><th>Status</th><th>Game</th><th>Author</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((g:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{g.title}</td><td class="text-muted">{g.status}</td><td class="text-muted">{g.game_name}</td><td class="text-muted">{g.author_name}</td><td class="text-muted">{g.updated_at}</td><td><a class="text-acid" href={`/admin/guides/${g.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No guides yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
