---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT * FROM authors ORDER BY name ASC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Authors</h1><a class="btn" href="/admin/authors/new">New author</a></div><p class="mt-4 text-muted">Manage author slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>SEO title</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((a:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{a.name}</td><td class="text-muted">{a.slug}</td><td class="text-muted">{a.seo_title||'—'}</td><td class="text-muted">{a.updated_at}</td><td><a class="text-acid" href={`/admin/authors/${a.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No authors yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
