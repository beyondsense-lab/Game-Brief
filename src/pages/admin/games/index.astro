---
import AdminLayout from '@/layouts/AdminLayout.astro'; import { all } from '@/db/queries/public'; const rows=await all(Astro,'SELECT g.*,d.name developer_name FROM games g LEFT JOIN developers d ON d.id=g.developer_id ORDER BY g.updated_at DESC');
---
<AdminLayout><div class="flex justify-between"><h1 class="text-3xl font-black">Games</h1><a class="btn" href="/admin/games/new">New game</a></div><p class="mt-4 text-muted">Manage game slugs and SEO metadata used across GAME//BRIEF content.</p><table class="mt-5 w-full text-sm"><thead><tr class="text-left text-muted"><th>Name</th><th>Slug</th><th>Genre</th><th>Developer</th><th>Updated</th><th>Actions</th></tr></thead><tbody>{rows.map((g:any)=><tr class="border-t border-line"><td class="py-3 font-bold">{g.name}</td><td class="text-muted">{g.slug}</td><td class="text-muted">{g.genre}</td><td class="text-muted">{g.developer_name}</td><td class="text-muted">{g.updated_at}</td><td><a class="text-acid" href={`/admin/games/${g.id}/edit`}>Edit</a></td></tr>)}</tbody></table>{rows.length===0&&<p class="mt-5 text-muted">No games yet. Create your first one to start organizing content for SEO.</p>}</AdminLayout>
