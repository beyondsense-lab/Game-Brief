---
import AdminLayout from '@/layouts/AdminLayout.astro'; import AdminGameForm from '@/components/AdminGameForm.astro'; import { all } from '@/db/queries/public'; const developers=await all(Astro,'SELECT id,name FROM developers ORDER BY name ASC'); const platforms=await all(Astro,'SELECT id,name FROM platforms ORDER BY name ASC');
---
<AdminLayout><h1 class="mb-5 text-3xl font-black">New Game</h1><AdminGameForm developers={developers} platforms={platforms} /></AdminLayout>
