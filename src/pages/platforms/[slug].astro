---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { getPlatformBySlug, getArticlesByPlatform } from '@/db/queries/public'; const platform=await getPlatformBySlug(Astro,Astro.params.slug!); if(!platform) return Astro.redirect('/404'); const articles=await getArticlesByPlatform(Astro,platform.id,24);
---
<BaseLayout seo={{title:platform.seo_title||`${platform.name} — GAME//BRIEF`,description:platform.seo_description||platform.description||`GAME//BRIEF coverage for ${platform.name}.`,path:`/platforms/${platform.slug}`}}><section class="container py-10"><div class="flex items-center gap-4">{platform.logo&&<img src={platform.logo} alt="" width="56" height="56" class="object-contain"/>}<div><p class="kicker">Platform</p><h1 class="text-5xl font-black">{platform.name}</h1></div></div>{platform.description&&<p class="mt-4 max-w-2xl text-muted">{platform.description}</p>}<div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((s:any)=><StoryCard story={s}/>)}</div>{articles.length===0&&<p class="mt-5 text-muted">No published stories for {platform.name} yet.</p>}</section></BaseLayout>
