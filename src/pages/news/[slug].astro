---
import { env } from 'cloudflare:workers'; import BaseLayout from '@/layouts/BaseLayout.astro'; import NewsletterSignup from '@/components/NewsletterSignup.astro'; import { getArticleBySlug,getPublishedArticles } from '@/db/queries/public'; import { renderMarkdown } from '@/lib/content/markdown'; import { breadcrumbJsonLd } from '@/lib/seo';
const article=await getArticleBySlug(Astro,Astro.params.slug!); if(!article) return Astro.redirect('/404'); const related=(await getPublishedArticles(Astro,4)).filter((a:any)=>a.slug!==article.slug); const base=env.PUBLIC_SITE_URL;
---
<BaseLayout seo={{title:article.seo_title||article.title,description:article.seo_description||article.excerpt,path:`/news/${article.slug}`,image:article.og_image||article.hero_image,type:'article'}}><script type="application/ld+json" set:html={JSON.stringify([breadcrumbJsonLd([{name:'Home',url:base},{name:'News',url:`${base}/news`},{name:article.title,url:`${base}/news/${article.slug}`}]),{'@context':'https://schema.org','@type':'NewsArticle',headline:article.title,description:article.excerpt,datePublished:article.published_at,author:{'@type':'Person',name:article.author_name||'GAME//BRIEF'}}])}></script><article class="container max-w-4xl py-10"><nav class="text-sm text-muted"><a href="/">Home</a> → <a href="/news">News</a> → {article.category_name}</nav><p class="kicker mt-8">{article.category_name||'News'}</p><h1 class="mt-3 text-5xl font-black leading-none md:text-7xl">{article.title}</h1><p class="mt-5 text-xl text-muted">{article.excerpt}</p><p class="mt-4 text-sm text-muted">By <a class="text-acid" href={`/authors/${article.author_slug}`}>{article.author_name}</a> · {article.published_at} · {article.reading_time} min read</p>{article.hero_image&&<img src={article.hero_image} alt={article.hero_image_alt||''} width="1200" height="675" class="mt-8 aspect-video w-full border border-line object-cover"/>}<div class="prose-gb mt-10" set:html={await renderMarkdown(article.content)} />{article.game_slug&&<aside class="card mt-8 p-5"><p class="kicker">Game hub</p><a class="text-2xl font-black text-acid" href={`/games/${article.game_slug}`}>{article.game_name}</a></aside>}</article><NewsletterSignup /><section class="container max-w-4xl py-10"><h2 class="kicker">Related stories</h2>{related.map((s:any)=><a class="block border-b border-line py-4 font-black" href={`/news/${s.slug}`}>{s.title}</a>)}</section></BaseLayout>
