---
import BaseLayout from '@/layouts/BaseLayout.astro'; import StoryCard from '@/components/StoryCard.astro'; import { getAuthorBySlug, getArticlesByAuthor } from '@/db/queries/public'; const author=await getAuthorBySlug(Astro,Astro.params.slug!); if(!author) return Astro.redirect('/404'); const articles=await getArticlesByAuthor(Astro,author.id,24);
---
<BaseLayout seo={{title:author.seo_title||`${author.name} — GAME//BRIEF`,description:author.seo_description||author.bio||`Articles by ${author.name} on GAME//BRIEF.`,path:`/authors/${author.slug}`}}><section class="container py-10"><div class="flex items-center gap-4"><p class="kicker">Author</p></div><div class="mt-2 flex items-center gap-4">{author.avatar&&<img src={author.avatar} alt={author.name} width="72" height="72" class="rounded-full object-cover"/>}<h1 class="text-5xl font-black">{author.name}</h1></div>{author.bio&&<p class="mt-4 max-w-2xl text-muted">{author.bio}</p>}{author.website&&<a class="mt-2 inline-block text-sm font-bold text-acid" href={author.website} rel="noopener noreferrer" target="_blank">Website</a>}<div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((s:any)=><StoryCard story={s}/>)}</div>{articles.length===0&&<p class="mt-5 text-muted">No published stories by {author.name} yet.</p>}</section></BaseLayout>
