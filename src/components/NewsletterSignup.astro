---
const {compact=false}=Astro.props;
---
<section class="border-y border-line bg-acid text-ink"><div class={`container grid gap-6 py-10 md:grid-cols-[1fr_auto] md:items-center ${compact?'':'py-14'}`}><div><p class="text-xs font-black uppercase tracking-[.22em]">Today's Gaming Brief</p><h2 class="mt-2 text-3xl font-black md:text-4xl">Get the signal, skip the noise.</h2><p class="mt-2 max-w-2xl font-semibold">A sharp gaming newsletter covering releases, industry moves, hardware, esports and guides — delivered when it matters, not every day for the sake of it.</p></div><form action="/api/newsletter/subscribe" method="post" class="flex flex-col gap-2 sm:flex-row"><label class="sr-only" for="email">Email</label><input id="email" name="email" type="email" required placeholder="you@example.com" class="min-w-0 border-2 border-zinc-900 bg-white px-4 py-3 text-zinc-900 placeholder:text-zinc-500 sm:min-w-72"/><button class="border-2 border-zinc-900 bg-zinc-900 px-5 py-3 font-black uppercase text-acid transition-colors hover:bg-zinc-800">Subscribe</button></form></div><p class="container pb-8 text-xs font-bold uppercase tracking-wide opacity-70 sm:pb-10">Free forever · No spam · Unsubscribe anytime</p></section>
