---
const {review={}, articles=[], games=[], action='/api/admin/reviews'}=Astro.props;
---
<form method="post" action={action} class="grid gap-5 lg:grid-cols-[1fr_360px]"><section class="card p-5"><label class="kicker">Verdict<textarea class="input mt-2 min-h-[140px]" name="verdict" placeholder="One or two sentence summary judgement">{review.verdict||''}</textarea></label><label class="mt-4 block text-sm font-bold">Pros<textarea class="input mt-2 min-h-[140px]" name="pros" placeholder="One per line">{review.pros||''}</textarea></label><label class="mt-4 block text-sm font-bold">Cons<textarea class="input mt-2 min-h-[140px]" name="cons" placeholder="One per line">{review.cons||''}</textarea></label></section><aside class="grid gap-4"><div class="card p-5"><h2 class="kicker">Score</h2><input class="input mt-3" name="score" type="number" min="0" max="10" step="0.1" value={review.score??''} placeholder="e.g. 8.5" required/><p class="mt-2 text-xs text-muted">Score out of 10.</p></div><div class="card p-5"><h2 class="kicker">Relationships</h2><label class="block text-xs font-bold text-muted">Article (the review write-up){articles.length===0&&<span class="text-red-400"> — write one first</span>}<select class="input mt-2" name="articleId" required><option value="">Select an article</option>{articles.map((a:any)=><option value={a.id} selected={review.article_id===a.id}>{a.title}</option>)}</select></label><label class="mt-3 block text-xs font-bold text-muted">Game (optional)<select class="input mt-2" name="gameId"><option value="">None</option>{games.map((g:any)=><option value={g.id} selected={review.game_id===g.id}>{g.name}</option>)}</select></label><input class="input mt-3" name="platform" value={review.platform||''} placeholder="Platform reviewed on"/></div><div class="card p-5"><button class="btn w-full">Save</button></div></aside></form>

