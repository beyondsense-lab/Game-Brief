---
const {article={},authors=[],categories=[],games=[],action='/api/admin/articles'}=Astro.props;
---
<form method="post" action={action} class="grid gap-5 lg:grid-cols-[1fr_360px]"><section class="card p-5"><label class="kicker">Title<input class="input mt-2" name="title" value={article.title||''} required/></label><label class="mt-4 block text-sm font-bold">Excerpt<textarea class="input mt-2" name="excerpt" required>{article.excerpt||''}</textarea></label><label class="mt-4 block text-sm font-bold">Markdown content<textarea class="input mt-2 min-h-[420px] font-mono" name="content" required>{article.content||''}</textarea></label></section><aside class="grid gap-4"><div class="card p-5"><h2 class="kicker">Publishing</h2><input class="input mt-3" name="slug" placeholder="slug" value={article.slug||''}/><select class="input mt-3" name="status"><option value="draft" selected={(article.status||'draft')==='draft'}>Draft</option><option value="scheduled" selected={article.status==='scheduled'}>Scheduled</option><option value="published" selected={article.status==='published'}>Published</option><option value="archived" selected={article.status==='archived'}>Archived</option></select><input class="input mt-3" name="scheduledAt" type="datetime-local" value={article.scheduled_at||''}/><button class="btn mt-4 w-full" name="intent" value="save">Save</button>{article.id&&<a class="btn mt-2 w-full" href={`/admin/articles/${article.id}/preview`}>Preview</a>}</div><div class="card p-5"><h2 class="kicker">Relationships</h2><label class="block text-xs font-bold text-muted">Author{authors.length===0&&<span class="text-red-400"> — create one first</span>}<select class="input mt-2" name="authorId" required><option value="">Select an author</option>{authors.map((a:any)=><option value={a.id} selected={article.author_id===a.id}>{a.name}</option>)}</select></label><label class="mt-3 block text-xs font-bold text-muted">Category{categories.length===0&&<span class="text-red-400"> — create one first</span>}<select class="input mt-2" name="categoryId" required><option value="">Select a category</option>{categories.map((c:any)=><option value={c.id} selected={article.category_id===c.id}>{c.name}</option>)}</select></label><label class="mt-3 block text-xs font-bold text-muted">Game (optional)<select class="input mt-2" name="gameId"><option value="">None</option>{games.map((g:any)=><option value={g.id} selected={article.game_id===g.id}>{g.name}</option>)}</select></label><label class="mt-3 block"><input type="checkbox" name="featured" checked={!!article.featured}/> Featured</label><label class="ml-4"><input type="checkbox" name="trending" checked={!!article.trending}/> Trending</label></div><div class="card p-5"><h2 class="kicker">Images & SEO</h2><input class="input mt-3" name="heroImage" placeholder="Hero image URL" value={article.hero_image||''}/><input class="input mt-3" name="heroImageAlt" placeholder="Hero alt text" value={article.hero_image_alt||''}/><input class="input mt-3" name="seoTitle" placeholder="SEO title" value={article.seo_title||''}/><textarea class="input mt-3" name="seoDescription" placeholder="SEO description">{article.seo_description||''}</textarea><input class="input mt-3" name="canonicalUrl" placeholder="Canonical URL" value={article.canonical_url||''}/><input class="input mt-3" name="ogImage" placeholder="OG image" value={article.og_image||''}/><label class="mt-3 block"><input type="checkbox" name="allowIndexing" checked={article.allow_indexing!==0}/> Index this article</label><div class="mt-4 border border-line p-3"><p class="text-xs text-muted">Google Search Preview</p><p class="font-bold text-blue-400">{article.seo_title||article.title||'Article title'}</p><p class="text-sm text-zinc-300">{article.seo_description||article.excerpt||'Article description preview.'}</p></div></div></aside></form>

