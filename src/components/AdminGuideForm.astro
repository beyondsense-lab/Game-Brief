---
const {guide={}, games=[], authors=[], action='/api/admin/guides'}=Astro.props;
---
<form method="post" action={action} class="grid gap-5 lg:grid-cols-[1fr_360px]"><section class="card p-5"><label class="kicker">Title<input class="input mt-2" name="title" value={guide.title||''} required/></label><label class="mt-4 block text-sm font-bold">Excerpt<textarea class="input mt-2" name="excerpt">{guide.excerpt||''}</textarea></label><label class="mt-4 block text-sm font-bold">Markdown content<textarea class="input mt-2 min-h-[420px] font-mono" name="content" required>{guide.content||''}</textarea></label></section><aside class="grid gap-4"><div class="card p-5"><h2 class="kicker">Publishing</h2><input class="input mt-3" name="slug" placeholder="slug" value={guide.slug||''}/><select class="input mt-3" name="status"><option value="draft" selected={guide.status==='draft'}>Draft</option><option value="published" selected={guide.status==='published'}>Published</option></select><input class="input mt-3" name="publishedAt" type="datetime-local" value={guide.published_at||''}/><input class="input mt-3" name="category" placeholder="Category label" value={guide.category||''}/><button class="btn mt-4 w-full">Save</button></div><div class="card p-5"><h2 class="kicker">Relationships</h2><label class="block text-xs font-bold text-muted">Game (optional)<select class="input mt-2" name="gameId"><option value="">None</option>{games.map((g:any)=><option value={g.id} selected={guide.game_id===g.id}>{g.name}</option>)}</select></label><label class="mt-3 block text-xs font-bold text-muted">Author<select class="input mt-2" name="authorId"><option value="">None</option>{authors.map((a:any)=><option value={a.id} selected={guide.author_id===a.id}>{a.name}</option>)}</select></label></div><div class="card p-5"><h2 class="kicker">Images & SEO</h2><input class="input mt-3" name="heroImage" placeholder="Hero image URL" value={guide.hero_image||''}/><input class="input mt-3" name="seoTitle" placeholder="SEO title" value={guide.seo_title||''}/><textarea class="input mt-3" name="seoDescription" placeholder="SEO description">{guide.seo_description||''}</textarea><input class="input mt-3" name="canonicalUrl" placeholder="Canonical URL" value={guide.canonical_url||''}/><div class="mt-4 border border-line p-3"><p class="text-xs text-muted">Google Search Preview</p><p class="font-bold text-blue-400">{guide.seo_title||guide.title||'Guide title'}</p><p class="text-sm text-zinc-300">{guide.seo_description||guide.excerpt||'Guide description preview.'}</p></div></div></aside></form>

