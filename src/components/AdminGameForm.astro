---
const {game={}, developers=[], platforms=[], selectedPlatformIds=[], action='/api/admin/games'}=Astro.props;
---
<form method="post" action={action} class="grid gap-5 lg:grid-cols-[1fr_360px]"><section class="card p-5"><label class="kicker">Name<input class="input mt-2" name="name" value={game.name||''} required/></label><label class="mt-4 block text-sm font-bold">Description<textarea class="input mt-2 min-h-[240px]" name="description">{game.description||''}</textarea></label><label class="mt-4 block text-sm font-bold">Genre<input class="input mt-2" name="genre" value={game.genre||''}/></label><label class="mt-4 block text-sm font-bold">Release date<input class="input mt-2" name="releaseDate" type="date" value={game.release_date||''}/></label><label class="mt-4 block text-sm font-bold">Official website<input class="input mt-2" name="officialWebsite" placeholder="https://" value={game.official_website||''}/></label></section><aside class="grid gap-4"><div class="card p-5"><h2 class="kicker">Publishing</h2><input class="input mt-3" name="slug" placeholder="slug" value={game.slug||''}/><button class="btn mt-4 w-full">Save</button></div><div class="card p-5"><h2 class="kicker">Relationships</h2><label class="block text-xs font-bold text-muted">Developer<select class="input mt-2" name="developerId"><option value="">None</option>{developers.map((d:any)=><option value={d.id} selected={game.developer_id===d.id}>{d.name}</option>)}</select></label>{platforms.length>0&&<div class="mt-3"><p class="text-xs font-bold text-muted">Platforms</p><div class="mt-2 grid gap-1">{platforms.map((p:any)=><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="platformIds" value={p.id} checked={selectedPlatformIds.includes(p.id)}/> {p.name}</label>)}</div></div>}</div><div class="card p-5"><h2 class="kicker">Cover & SEO</h2><input class="input mt-3" name="coverImage" placeholder="Cover image URL" value={game.cover_image||''}/><input class="input mt-3" name="coverImageAlt" placeholder="Cover image alt text" value={game.cover_image_alt||''}/><input class="input mt-3" name="seoTitle" placeholder="SEO title" value={game.seo_title||''}/><textarea class="input mt-3" name="seoDescription" placeholder="SEO description">{game.seo_description||''}</textarea><div class="mt-4 border border-line p-3"><p class="text-xs text-muted">Google Search Preview</p><p class="font-bold text-blue-400">{game.seo_title||game.name||'Game title'}</p><p class="text-sm text-zinc-300">{game.seo_description||game.description||'Game description preview.'}</p></div></div></aside></form>


