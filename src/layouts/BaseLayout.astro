---
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { canonical, organizationJsonLd, websiteJsonLd, type Seo } from '@/lib/seo';
const seo:Seo=Astro.props.seo || {title:'GAME//BRIEF',description:'The gaming news worth knowing.'};
const base=env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://gamebrief.example.com';
const url=canonical(base, seo.path || Astro.url.pathname);
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><script is:inline>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('gb-theme')||'dark')}catch(e){}</script><title>{seo.title}</title><meta name="description" content={seo.description}/><link rel="canonical" href={url}/><meta name="robots" content={seo.noindex?'noindex,follow':'index,follow'}/><meta property="og:title" content={seo.title}/><meta property="og:description" content={seo.description}/><meta property="og:url" content={url}/><meta property="og:type" content={seo.type||'website'}/>{seo.image&&<meta property="og:image" content={seo.image}/>}<meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify([organizationJsonLd(base),websiteJsonLd(base)])}></script></head><body><header class="sticky top-0 z-40 border-b border-line bg-ink/95 backdrop-blur"><div class="container flex h-16 items-center justify-between gap-4"><a href="/" class="font-display text-xl font-black tracking-tight">GAME<span class="text-acid">//</span>BRIEF</a><nav class="hidden gap-5 text-sm font-bold uppercase tracking-wide text-muted md:flex"><a href="/news">News</a><a href="/reviews">Reviews</a><a href="/guides">Guides</a><a href="/games">Games</a><a href="/platforms">Platforms</a><a href="/esports">Esports</a><a href="/newsletter">Newsletter</a></nav><div class="flex items-center gap-2"><a class="icon-btn hidden sm:flex" href="/search" aria-label="Search"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></a><ThemeToggle /><details class="relative md:hidden"><summary class="icon-btn cursor-pointer list-none" aria-label="Open menu"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></summary><nav class="absolute right-0 top-full mt-2 flex w-56 flex-col gap-1 border border-line bg-panel p-3 text-sm font-bold uppercase tracking-wide text-muted shadow-brutal"><a class="px-2 py-2 hover:text-acid" href="/news">News</a><a class="px-2 py-2 hover:text-acid" href="/reviews">Reviews</a><a class="px-2 py-2 hover:text-acid" href="/guides">Guides</a><a class="px-2 py-2 hover:text-acid" href="/games">Games</a><a class="px-2 py-2 hover:text-acid" href="/platforms">Platforms</a><a class="px-2 py-2 hover:text-acid" href="/esports">Esports</a><a class="px-2 py-2 hover:text-acid" href="/newsletter">Newsletter</a><a class="px-2 py-2 hover:text-acid" href="/search">Search</a></nav></details></div></div></header><main><slot /></main><footer class="mt-20 border-t border-line bg-panel"><div class="container grid gap-8 py-12 md:grid-cols-3"><div><div class="font-display text-2xl font-black">GAME<span class="text-acid">//</span>BRIEF</div><p class="mt-2 text-muted">The gaming news worth knowing.</p></div><div><h2 class="kicker">Sections</h2><p class="mt-3 grid grid-cols-2 gap-2 text-sm"><a href="/news">News</a><a href="/reviews">Reviews</a><a href="/guides">Guides</a><a href="/games">Games</a><a href="/releases">Releases</a><a href="/newsletter">Newsletter</a></p></div><div><h2 class="kicker">Company</h2><p class="mt-3 grid grid-cols-2 gap-2 text-sm"><a href="/about">About</a><a href="/contact">Contact</a><a href="/editorial-policy">Editorial Policy</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/advertise">Advertise</a></p></div></div></footer></body></html>
