---
import '../styles/global.css';
import { canonical, organizationJsonLd, websiteJsonLd, type Seo } from '@/lib/seo';
const seo:Seo=Astro.props.seo || {title:'GAME//BRIEF',description:'The gaming news worth knowing.'};
const base=Astro.locals.runtime?.env?.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://gamebrief.example.com';
const url=canonical(base, seo.path || Astro.url.pathname);
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{seo.title}</title><meta name="description" content={seo.description}/><link rel="canonical" href={url}/><meta name="robots" content={seo.noindex?'noindex,follow':'index,follow'}/><meta property="og:title" content={seo.title}/><meta property="og:description" content={seo.description}/><meta property="og:url" content={url}/><meta property="og:type" content={seo.type||'website'}/>{seo.image&&<meta property="og:image" content={seo.image}/>}<meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify([organizationJsonLd(base),websiteJsonLd(base)])}></script></head><body><header class="sticky top-0 z-40 border-b border-line bg-ink/95 backdrop-blur"><div class="container flex h-16 items-center justify-between"><a href="/" class="font-display text-xl font-black tracking-tight">GAME<span class="text-acid">//</span>BRIEF</a><nav class="hidden gap-5 text-sm font-bold uppercase tracking-wide text-muted md:flex"><a href="/news">News</a><a href="/reviews">Reviews</a><a href="/guides">Guides</a><a href="/games">Games</a><a href="/platforms">Platforms</a><a href="/hardware">Hardware</a><a href="/esports">Esports</a><a href="/newsletter">Newsletter</a></nav><a class="text-sm font-bold" href="/search">Search</a></div></header><main><slot /></main><footer class="mt-20 border-t border-line bg-panel"><div class="container grid gap-8 py-12 md:grid-cols-3"><div><div class="font-display text-2xl font-black">GAME<span class="text-acid">//</span>BRIEF</div><p class="mt-2 text-muted">The gaming news worth knowing.</p></div><div><h2 class="kicker">Sections</h2><p class="mt-3 grid grid-cols-2 gap-2 text-sm"><a href="/news">News</a><a href="/reviews">Reviews</a><a href="/guides">Guides</a><a href="/games">Games</a><a href="/releases">Releases</a><a href="/newsletter">Newsletter</a></p></div><div><h2 class="kicker">Company</h2><p class="mt-3 grid grid-cols-2 gap-2 text-sm"><a href="/about">About</a><a href="/contact">Contact</a><a href="/editorial-policy">Editorial Policy</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/advertise">Advertise</a></p></div></div></footer></body></html>
