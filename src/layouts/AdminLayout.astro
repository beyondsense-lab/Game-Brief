import '../styles/global.css'; import ThemeToggle from '@/components/ThemeToggle.astro'; const user=Astro.locals.user;
---
<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><script is:inline>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('gb-theme')||'dark')}catch(e){}</script><title>GAME//BRIEF CMS</title></head><body><div class="min-h-screen bg-ink"><header class="border-b border-line bg-panel"><div class="flex h-14 items-center justify-between px-5"><a href="/admin/dashboard" class="font-display font-black">GAME<span class="text-acid">//</span>BRIEF CMS</a><div class="flex items-center gap-3"><ThemeToggle /><form method="post" action="/api/admin/logout" class="flex items-center"><span class="mr-3 text-sm text-muted">{user?.name}</span><button class="text-sm font-bold text-acid">Logout</button></form></div></div></header><div class="grid md:grid-cols-[220px_1fr]"><aside class="border-r border-line p-4"><nav class="grid gap-2 text-sm font-bold"><a href="/admin/dashboard">Dashboard</a><a href="/admin/articles">Articles</a><a href="/admin/games">Games</a><a href="/admin/reviews">Reviews</a><a href="/admin/esports">Esports</a><a href="/admin/guides">Guides</a><a href="/admin/authors">Authors</a><a href="/admin/categories">Categories</a><a href="/admin/tags">Tags</a><a href="/admin/developers">Developers</a><a href="/admin/platforms">Platforms</a><a href="/admin/media">Media</a><a href="/admin/newsletter">Newsletter</a><a href="/admin/settings">Settings</a></nav></aside><main class="p-5"><slot /></main></div></div></body></html>

